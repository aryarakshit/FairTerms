# FairTerms Fairness Engine — Environment Variables

# Server
PORT=8081
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins
# For local dev: http://localhost:3000,http://localhost:5000
# For production: https://fairterms-backend-xyz-an.a.run.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# BigQuery (set BIGQUERY_ENABLED=true to use BigQuery instead of local CSV)
BIGQUERY_ENABLED=false
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=fairterms
BIGQUERY_TABLE=benchmarks

# Seed Data
SEED_DATA_PATH=data/seed_data.csv
SEED_RECORD_COUNT=1000
