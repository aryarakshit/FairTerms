# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to your service account JSON (copy firebase-adminsdk.json.example → firebase-adminsdk.json
# and fill in real values from Firebase Console → Project Settings → Service Accounts)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json

# ── Fairness Engine (Python microservice) ─────────────────────────────────────
FAIRNESS_ENGINE_URL=http://localhost:8081/compute
FAIRNESS_ENGINE_BASE_URL=http://localhost:8081
FAIRNESS_ENGINE_TIMEOUT_MS=10000

# ── AI / LLM provider ─────────────────────────────────────────────────────────
# Primary: Groq (fast inference via Llama)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: OpenRouter (optional)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Indian financial constants ─────────────────────────────────────────────────
RBI_BANK_RATE=6.5
DEFAULT_BUYER_TAX_RATE=25.0

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# ── Dev/mock flags (set to false in production) ───────────────────────────────
USE_MOCK_FIRESTORE=false
USE_MOCK_GEMINI=false
ALLOW_MOCK_GEMINI=false
ALLOW_MOCK_AUTH=false

# ── Request limits ─────────────────────────────────────────────────────────────
JSON_BODY_LIMIT=50kb
